# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# Local configuration and secrets
.env
.DS_Store

# Tooling and editor caches
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
.idea/
.vscode/
*.swp

# Course source PDFs are local reading inputs, not project data
intro-mlproj.pdf
project-pool.pdf
docs/project-pool(1).pdf

# Downloaded/generated data and uncurated experiment outputs
data/raw/*
data/interim/*
data/processed/*
results/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
# User-authorized frozen collaboration input; other generated data remain ignored.
!data/processed/g0_rebuild_20261004/
!data/processed/g0_rebuild_20261004/**
data/processed/g0_rebuild_20261004/run_manifest.json
!results/.gitkeep

# Only reviewed, small, report-facing motif results may be versioned here.
# Keep raw MEME output in the ignored tmp/ work area, not under results/motif/.
!results/motif/
!results/motif/**
results/motif/**/*.fa
results/motif/**/*.fasta
results/motif/**/*.fna
results/motif/**/*.npy
results/motif/**/*.npz
results/motif/**/*.html
results/motif/**/*.xml

# Reviewed, aggregate M1/M2 outputs may be versioned; source-level sequence
# tables and full candidate-hit records remain in ignored data/ or tmp/ paths.
!results/eda/
!results/eda/**

# Local tool caches are reproducible and should not be committed.
.cache/

# Temporary PDF renders and local clones
tmp/

# Reviewable aggregate audit evidence; raw sequences and machine paths stay local.
!results/data_audit/
results/data_audit/*
!results/data_audit/audit_20261004_final/
results/data_audit/audit_20261004_final/*
!results/data_audit/audit_20261004_final/README.md
!results/data_audit/audit_20261004_final/data_profiles.json
!results/data_audit/audit_20261004_final/artifact_hash_checks.tsv
!results/data_audit/audit_20261004_final/legacy_holdout_near_duplicates.tsv
!results/data_audit/audit_20261004_final/public_audit_summary.json

# Frozen G0 aggregate evidence; genomic sequences and raw source pages stay local.
!results/data_audit/g0_rebuild_20261004/
results/data_audit/g0_rebuild_20261004/*
!results/data_audit/g0_rebuild_20261004/rebuild_summary.json
!results/data_audit/g0_rebuild_20261004/independent_gate_complete.json
!results/data_audit/g0_rebuild_20261004/*_summary.tsv
!results/data_audit/g0_rebuild_20261004/label_retention.tsv
!results/data_audit/g0_rebuild_20261004/supplement_manifest.json
!results/data_audit/g0_rebuild_20261004/m1_acceptance_20261005.json
